<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.easytranslate.view.FloatingViewController"
      fx:id="root" prefWidth="588" styleClass="floating-root">
    <HBox fx:id="decorations" alignment="BOTTOM_LEFT" minHeight="48" prefHeight="48"
          mouseTransparent="true" styleClass="decorations">
        <Pane fx:id="catHost" prefWidth="70" minWidth="70" maxWidth="70" prefHeight="43" minHeight="43" maxHeight="43">
            <ImageView fx:id="catImage" fitWidth="70" fitHeight="46" preserveRatio="true" smooth="true"/>
        </Pane>
        <Region HBox.hgrow="ALWAYS"/>
        <Pane fx:id="deskHost" prefWidth="91" minWidth="91" maxWidth="91" prefHeight="48" minHeight="48" maxHeight="48">
            <ImageView fx:id="deskImage" fitWidth="104" fitHeight="48" preserveRatio="true" smooth="true"/>
        </Pane>
    </HBox>
    <VBox styleClass="floating-window">
        <HBox alignment="CENTER_LEFT" spacing="9" styleClass="drag-bar"
              onMousePressed="#onDragStarted" onMouseDragged="#onDragging">
            <StackPane fx:id="brandIcon"/>
            <Label text="EasyTranslate" styleClass="window-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ToggleButton fx:id="pinButton" onAction="#onTogglePin" focusTraversable="false"
                          accessibleText="切换窗口置顶" styleClass="icon-button"/>
            <Button fx:id="closeButton" onAction="#onClose" focusTraversable="false"
                    accessibleText="关闭窗口" styleClass="icon-button,close-button"/>
        </HBox>
        <HBox spacing="22" styleClass="translation-body">
            <VBox fx:id="sourceColumn" spacing="8" prefWidth="0" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" minHeight="28">
                    <Label text="原文 · EN" styleClass="section-label"/>
                </HBox>
                <ScrollPane fx:id="sourceScroll" fitToWidth="true" hbarPolicy="NEVER"
                            prefHeight="68" minHeight="64" focusTraversable="false" styleClass="text-scroll">
                    <Label fx:id="sourceLabel" wrapText="true" maxWidth="Infinity" styleClass="source-text"/>
                </ScrollPane>
            </VBox>
            <Separator fx:id="columnDivider" orientation="VERTICAL" styleClass="column-divider"/>
            <VBox spacing="8" prefWidth="0" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" minHeight="28">
                    <Label text="译文 · 中文" styleClass="section-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="copyButton" onAction="#onCopy" focusTraversable="false"
                            accessibleText="复制译文" styleClass="icon-button,copy-button"/>
                </HBox>
                <ScrollPane fx:id="translatedScroll" fitToWidth="true" hbarPolicy="NEVER"
                            prefHeight="68" minHeight="64" focusTraversable="false" styleClass="text-scroll">
                    <Label fx:id="translatedLabel" wrapText="true" maxWidth="Infinity" styleClass="translated-text"/>
                </ScrollPane>
            </VBox>
        </HBox>
        <Separator styleClass="footer-divider"/>
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="footer">
            <Region fx:id="statusDot" styleClass="status-dot"/>
            <Label fx:id="statusLabel" text="等待划词" styleClass="status-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="vocabularyButton" text="单词本" onAction="#onVocabulary"
                    focusTraversable="false" styleClass="text-button"/>
            <Separator orientation="VERTICAL" prefHeight="16" maxHeight="16"/>
            <Button fx:id="settingsButton" text="设置" onAction="#onSettings"
                    focusTraversable="false" styleClass="text-button"/>
        </HBox>
    </VBox>
</VBox>
